# Git Ignore File 

# Dependencies
node_modules/
jspm_packages/


# Build outputs
dist/
build/
*.tsbuildinfo


# Test results and coverage
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/


# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.pid.lock


# Environment variables and secrets
.env
.env.*
!.env.example


# SSH private keys and credentials
*.pem
*.ppk
id_rsa
id_ed25519
minishop-actions-deploy


# Local caches
.cache/
.parcel-cache/
.vite/
.npm/
.eslintcache


# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db


# Temporary files
*.tmp
*.temp
*.swp
*.swo
